:root {
	--bg-primary: #141414;
    --bg-secondary: #333333;
    --bg-tertiary: #292929;
    --text-primary: #ffffff;
    --text-secondary: #939393;
    --text-tertiary: #656565;
    --text-inverse: #000000;
    --accent-primary: #ffffff;
    --accent-secondary: #939393;
    --accent-hover: #344f73;
    --accent-like: #d94040;
    --accent-repost: #3d5f8a;
    --link-color: #fcfcfc;
    --border-color: #555555;
    --block-bg: #222222;
    --block-bg-secondary: #333333;
    --block-hover-bg: #3b3b3b;
    --bg-hover: rgba(0, 0, 0, .03);
    --bg-active: rgba(0, 0, 0, .06);
    --tab-active-bg: #e2e9ef;
    --settings-tab-active-bg: #e2e9ef;
    --toggle-active-bg: #4a78ad;
    --glass-bg: #ffffff;
    --nav-gradient: none;
    --btn-primary-bg: #434343;
    --btn-primary-text: #ffffff;
    --shadow-elevated: none;
    --poll-progress-color: #e2e9ef;
    --poll-selected-progress-color: #4a78ad;
    --poll-inverted-text: #ffffff;
    --transition-normal: .15s ease;
    --radius-sm: 2px;
    --radius-md: 4px;
    --radius-full: 9999px;
    --spacing-xs: 3px;
    --spacing-sm: 6px;
    --spacing-md: 10px;
    --spacing-lg: 15px;
    --spacing-2xl: 20px;
    --sidebar-width: 160px;
    --sidebar-gap: 16px;
    --content-max-width: 550px;
    --right-sidebar-width: 230px;
    --header-height: 42px;
    --header-bg: #222222;
    --scrollbar-compensation: 0px;

}

*,*:before,*:after {
	box-sizing: border-box;
	margin: 0;
	padding: 0;
}

html {
	font-size: 13px;
	overflow-y: scroll;
}

body {
	font-family: Tahoma,Arial,Verdana,sans-serif;
	line-height: 1.462;
	background-color: var(--bg-primary);
	color: var(--text-primary);
	touch-action: pan-x pan-y;
	margin-right: var(--scrollbar-compensation, 0px);
}

a {
	color: var(--link-color);
	text-decoration: none;
}

a:hover {
	text-decoration: underline;
}

ul,ol {
	list-style: none;
}

img,picture,video,canvas,svg {
	display: block;
	max-width: 100%;
}

input,button,textarea,select {
	font: inherit;
	color: inherit;
}

button {
	cursor: pointer;
	background: none;
	border: none;
}

h1,h2,h3,h4,h5,h6 {
	font-weight: 700;
	line-height: 1.2;
}

@keyframes flash-highlight-light {
	0% {
		background-color: #45668e1a;
	}

	to {
		background-color: transparent;
	}
}

@keyframes flash-highlight-dark {
	0% {
		background-color: #71aaeb1f;
	}

	to {
		background-color: transparent;
	}
}

.flash-highlight {
	animation: flash-highlight-light .8s ease-out;
	border-radius: 0;
}

[data-theme=dark] .flash-highlight {
	animation: flash-highlight-dark .8s ease-out;
}

::-webkit-scrollbar {
	width: 12px;
	height: 12px;
}

::-webkit-scrollbar-track {
	background: var(--bg-primary);
}

::-webkit-scrollbar-thumb {
	background: silver;
	border: 3px solid var(--bg-primary);
	border-radius: 6px;
}

::-webkit-scrollbar-thumb:hover {
	background: #a0a0a0;
}

* {
	scrollbar-width: thin;
	scrollbar-color: #c0c0c0 var(--bg-primary);
}

.container {
	width: 100%;
	max-width: 1000px;
	margin: 0 auto;
	padding: 0 var(--spacing-md);
}

#root {
	min-height: 100vh;
}

@keyframes spin {
	0% {
		transform: rotate(0);
	}

	to {
		transform: rotate(360deg);
	}
}

